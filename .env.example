VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GEMINI_KEY=your-gemini-api-key
VITE_MAPBOX_TOKEN=your-mapbox-public-token
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_MAPTILER_KEY=your-maptiler-api-key

# Server-side only — never prefix with VITE_ (that would bundle it into the client,
# the exact S-001 vulnerability this project's Phase 10 security hardening closes).
# Used by scripts/seed-demo-users.mjs, scripts/run-migrations.mjs, and as an Edge
# Function secret (`supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...`).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
